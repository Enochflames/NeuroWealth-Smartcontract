{
  "name": "neurowealth-whatsapp",
  "version": "1.0.0",
  "description": "WhatsApp Bot Handler with OTP verification for NeuroWealth",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "rotate-keys": "node dist/rotateKeys.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "tsc && env NODE_ENV=test ENCRYPTION_KEY=test-encryption-key-at-least-32-chars-long-0123 PHONE_HASH_SALT=test-phone-salt-0123456789 DATABASE_URL=postgresql://neurowealth_test@localhost:5432/neurowealth_test TWILIO_AUTH_TOKEN=test-twilio-auth-token-0123456789 node --test $(find dist -name '*.test.js')"
  },
  "dependencies": {
    "@neurowealth/vault-client": "file:../packages/vault-client",
    "@stellar/stellar-sdk": "^16.1.0",
    "body-parser": "^1.20.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.11.5",
    "pino": "^9.0.0",
    "twilio": "^5.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@types/body-parser": "^1.19.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "eslint": "^8.56.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
